model Problem {
  id          String      @id @default(uuid())
  title       String
  description String
  type        ProblemType
  difficulty  Difficulty
  marks       Int
  options     Json?
  answer      String?
  deletedAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  createdBy String

  creator User @relation("ProblemCreator", fields: [createdBy], references: [id], onDelete: Cascade, onUpdate: Cascade)

  assessmentProblems AssessmentProblem[]

  answers Answer[]

  @@index([createdBy], name: "idx_problem_createdBy")
  @@index([type], name: "idx_problem_type")
  @@index([difficulty], name: "idx_problem_difficulty")
  @@index([deletedAt], name: "idx_problem_deletedAt")
  @@map("problems")
}
