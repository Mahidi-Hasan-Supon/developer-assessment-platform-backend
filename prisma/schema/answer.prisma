model Answer {
  id           String    @id @default(uuid())
  submissionId String
  problemId    String
  answer       String?
  marks        Float     @default(0)
  isCorrect    Boolean?
  evaluatedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([submissionId, problemId], name: "uq_answer_submission_problem")
  @@index([problemId], name: "idx_answer_problemId")
  @@map("answers")
}
