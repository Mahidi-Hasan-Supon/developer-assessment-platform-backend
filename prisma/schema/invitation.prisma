model Invitation {
  id           String           @id @default(uuid())
  assessmentId String
  candidateId  String
  status       InvitationStatus @default(PENDING)
  invitedAt    DateTime         @default(now())
  expiresAt    DateTime?
  acceptedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  candidate User @relation("CandidateInvitations", fields: [candidateId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  attempt Attempt?

  @@unique([assessmentId, candidateId], name: "uq_invitation_assessment_candidate")
  @@index([candidateId], name: "idx_invitation_candidateId")
  @@index([assessmentId], name: "idx_invitation_assessmentId")
  @@index([status], name: "idx_invitation_status")
  @@map("invitations")
}
