model Attempt {
  id           String        @id @default(uuid())
  invitationId String        @unique
  candidateId  String
  assessmentId String
  startedAt    DateTime      @default(now())
  expiresAt    DateTime
  submittedAt  DateTime?
  status       AttemptStatus @default(IN_PROGRESS)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  candidate User @relation(fields: [candidateId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  submission Submission?

  @@index([candidateId], name: "idx_attempt_candidateId")
  @@index([assessmentId], name: "idx_attempt_assessmentId")
  @@index([status], name: "idx_attempt_status")
  @@index([expiresAt], name: "idx_attempt_expiresAt")
  @@map("attempts")
}
