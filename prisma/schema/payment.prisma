model Payment {
  id            String          @id @default(uuid())
  amount        Float
  currency      String          @default("BDT")
  provider      PaymentProvider
  transactionId String?         @unique
  providerPaymentId String?     @unique
  status        PaymentStatus   @default(PENDING)
  paidAt        DateTime?
  failedAt      DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  assessmentId String
  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId], name: "idx_payment_userId")
  @@index([assessmentId], name: "idx_payment_assessmentId")
  @@index([status], name: "idx_payment_status")
  @@index([provider], name: "idx_payment_provider")
  @@map("payments")
}